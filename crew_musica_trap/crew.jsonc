{
  "name": "crew_musica_trap",
  "agents": ["scout", "analista", "redattore"],
  "tasks": [
    {
      "name": "ricerca_task",
      "description": "Cerca sul web articoli, reddit o novità riguardanti la scelta dello 808 e i pattern hi-hat di questo specifico artista: {artista}. Trova almeno 2 fonti recenti dell'anno 2026.",
      "expected_output": "Lista di 2 fonti o tecniche chiave, con titolo, link e un riassunto dei dettagli.",
      "agent": "scout"
    },
    {
      "name": "analisi_task",
      "description": "Analizza i 2 risultati dello Scout. Seleziona le tendenze di produzione trap più utili e spiega tecnicamente perché funzionano.",
      "expected_output": "Analisi dettagliata delle novità, con focus su sound design (es. 808, hi-hat) e i bpm e chiavi musicali che vengono più utilizzate.",
      "agent": "analista"
    },
    {
      "name": "scrittura_task",
      "description": "Prendi le tendenze selezionate dall'Analista e scrivi un report finale. ATTENZIONE RIGOROSA: Devi usare ESCLUSIVAMENTE titoli in lingua italiana per le sezioni. I titoli obbligatori sono: 'Sintesi delle Tendenze', 'Analisi delle Produzioni', 'Consigli per il Beatmaking', 'Conclusioni'. Non usare nessun termine in inglese per le intestazioni, PER IL RESTO INVECE, CIò CHE DEVE ESSERE IN INGLESE DEVE ESSERE IN INGLESE.",
      "expected_output": "Un report finale in markdown pronto per la pubblicazione.",
      "output_file": "report_trap_2026.md",
      "agent": "redattore"
    }
  ],
  "process": "sequential",
  "verbose": true,
  "memory": false,
  "inputs": {
    "topic": "Nuovi pattern di 808 e pattern hi-hat nella musica trap americana"
  }
}
