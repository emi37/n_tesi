{
  "name": "my_first_crew",

  "agents": [
    "academic_research_specialist",
    "verificatore_ricerca"
  ],

  "tasks": [ //l'ordine delle tasks è importante perché sequenziale:
{ // task 1 del ricercatore, cerca le informazioni
"name": "conduct_thorough_research_about_task",
"description": "Leggi il contenuto del file programma.java presente nella cartella data utilizzando FileReaderTool. Analizza esclusivamente il codice contenuto nel file e prepara un breve report basato sulla sua analisi.",
"expected_output": "Un report markdown conciso con massimo 3 fonti pertinenti. Per ogni fonte indica titolo, URL e una breve sintesi delle informazioni rilevanti (massimo 2 righe). Concludi con una sintesi generale dell'argomento di massimo 5 righe.",
"agent": "academic_research_specialist"
},

//task 2: il verificatore si assicura che le informazioni siano corretta
{
"name": "verify_research_results_task",
"description": "Analizza il report prodotto dal precedente agente Academic Research Specialist. Verifica le informazioni contenute nel report e individua eventuali elementi che richiedono ulteriori verifiche.",
"expected_output": "Un report finale strutturato in markdown contenente una valutazione delle informazioni prodotte dal primo agente, le eventuali criticità individuate e una distinzione chiara tra informazioni supportate e informazioni non sufficientemente supportate.",
"agent": "verificatore_ricerca",
"context": ["conduct_thorough_research_about_task"] //usa come input, l'output dell'agente 1  
}
  ],
  

  "process": "sequential",
  "verbose": true,
  "memory": false,
  "stream": false,
  "inputs": {}
}
